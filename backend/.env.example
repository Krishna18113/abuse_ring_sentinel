# ==============================================================================
# Abuse Ring Sentinel — Environment Configuration Template
# ==============================================================================

# Neo4j Database Connection (Default values match docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=testpassword123

# Google Gemini API Configuration
# Optional: The platform automatically uses an instant deterministic fallback
# if GEMINI_API_KEY is not set, ensuring 100% functionality without credentials.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
